{
  "id": "STATION-LIVEBRIDGE",
  "version": "1.0.0",
  "build": "iki1uc-livebridge",
  "role": "LIVEBRIDGE-MASTER",

  "bridge": {
    "enabled": true,
    "interval": 150
  },

  "sync": {
    "live_to_runtime": "SYNC_LIVE_RUNTIME",
    "runtime_to_system": "SYNC_RUNTIME_SYSTEM",
    "system_to_live": "SYNC_SYSTEM_LIVE"
  },

  "flow": {
    "input": "BRIDGE_INPUT",
    "process": "BRIDGE_PROCESS",
    "output": "BRIDGE_OUTPUT"
  },

  "state": {
    "bridge": "IDLE",
    "live": "READY",
    "runtime": "READY",
    "system": "ACTIVE"
  },

  "status": "LIVEBRIDGE_READY"
}
