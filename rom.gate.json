{
  "id": "STATION-ROM-GATE",
  "instance": "iki1uc",
  "role": "ROM-GATE-LINK",

  "paths": {
    "rom": "STATION/ROOT/",
    "tmp": "STATION/tmp/",
    "pipe": "STATION/PIPE/",
    "root": "STATION/root.ext.js",
    "api": "STATION/api.core.js",
    "livebridge": "STATION/livebridge.js"
  },

  "rules": {
    "allow": ["ROM", "TMP", "PIPE", "ROOT", "API"],
    "deny": ["VOID", "NULL", "ERROR"],
    "priority": "high"
  },

  "hotswap": {
    "enabled": true,
    "rom_to_tmp": true,
    "tmp_to_rom": true
  },

  "status": "READY"
}
